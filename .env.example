# Copy this file to .env.local and fill in the values. Never commit .env.local.
# The same variables go into Vercel under Settings > Environment Variables
# for Preview and Production.

# Supabase project URL.
# Supabase dashboard > Project Settings > API > Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (starts with sb_publishable_).
# Supabase dashboard > Project Settings > API Keys. Safe to ship to the
# browser because Row Level Security is the real gate. The legacy anon key
# also works here. NEVER the secret key: every NEXT_PUBLIC_ value is copied
# into the JavaScript every visitor downloads, and the build refuses to run
# when a NEXT_PUBLIC_ variable holds a secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Supabase secret key (starts with sb_secret_; the legacy service_role key
# also works). SERVER ONLY, never NEXT_PUBLIC_. It bypasses Row Level Security
# and is used solely for Auth admin calls (creating, banning and unbanning
# logins) inside owner-only server actions, and by the test suites.
# Supabase dashboard > Project Settings > API Keys > Secret keys.
SUPABASE_SERVICE_ROLE_KEY=your_secret_key

# Google Maps Platform key for address suggestions, with Places API (New)
# enabled. Optional: without it the address field is plain text and leads
# save without a map position. It ships to the browser, so restrict it in
# Google Cloud to the production site and localhost ports 3000 and 3300.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key

# Copy this file to .env.local and fill in the values. Never commit .env.local.
# The same variables go into Vercel under Settings > Environment Variables
# for Preview and Production.

# Supabase project URL.
# Supabase dashboard > Project Settings > API > Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (starts with sb_publishable_).
# Supabase dashboard > Project Settings > API Keys. Safe to ship to the
# browser because Row Level Security is the real gate. The legacy anon key
# also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Supabase service role key. SERVER ONLY, never NEXT_PUBLIC_. It bypasses Row
# Level Security and is used solely for Auth admin calls (creating, banning and
# unbanning logins) inside owner-only server actions, and by `npm run test:rls`.
# Supabase dashboard > Project Settings > API Keys > service_role.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Copy this file to .env.local and fill in the values. Never commit .env.local.
# The same variables go into Vercel under Settings > Environment Variables
# for Preview and Production.

# Supabase project URL.
# Supabase dashboard > Project Settings > API > Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (starts with sb_publishable_).
# Supabase dashboard > Project Settings > API Keys. Safe to ship to the
# browser because Row Level Security is the real gate. The legacy anon key
# also works here. NEVER the secret key: every NEXT_PUBLIC_ value is copied
# into the JavaScript every visitor downloads, and the build refuses to run
# when a NEXT_PUBLIC_ variable holds a secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Supabase secret key (starts with sb_secret_; the legacy service_role key
# also works). SERVER ONLY, never NEXT_PUBLIC_. It bypasses Row Level Security
# and is used solely for Auth admin calls (creating, banning and unbanning
# logins) inside owner-only server actions, and by the test suites.
# Supabase dashboard > Project Settings > API Keys > Secret keys.
SUPABASE_SERVICE_ROLE_KEY=your_secret_key

# Google Maps Platform key for address suggestions, with Places API (New)
# enabled. Optional: without it the address field is plain text and leads
# save without a map position. It ships to the browser, so restrict it in
# Google Cloud to the production site and localhost ports 3000 and 3300.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key

# The customer quote link (2026-11-02). Optional: the address links are built
# from, with no trailing slash. Unset, links use the address the app was
# opened on, which is right for previews and for the Vercel address. Set it
# to https://quote.vesperlighting.ca once that domain points at this app.
QUOTE_BASE_URL=

# Web push for Keenan's phone and iPad (Book my install). SERVER ONLY, never
# NEXT_PUBLIC_. Make the pair in the app: Admin > Settings > Notifications >
# Make the keys, then paste both here and into Vercel (Production and
# Preview) and redeploy. Changing them later means turning notifications on
# again on each device. Without them the app works and sends no pushes.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional: who the push services contact about these keys.
# Defaults to mailto:info@vesperlighting.ca.
VAPID_SUBJECT=

# Set by next.config.ts at build time (the deploy's commit, else a stamp), never by hand: the update notice compares it with /api/version.
# NEXT_PUBLIC_APP_BUILD=

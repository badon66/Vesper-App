# Copy this file to .env.local and fill in the values. Never commit .env.local.
# The same variables go into Vercel under Settings > Environment Variables
# for Preview and Production.

# Supabase project URL.
# Supabase dashboard > Project Settings > API > Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (starts with sb_publishable_).
# Supabase dashboard > Project Settings > API Keys. Safe to ship to the
# browser because Row Level Security is the real gate. The legacy anon key
# also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
